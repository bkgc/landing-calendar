rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isOwner(businessId) {
      return signedIn()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && slug.matches('^[a-z0-9-]{3,30}$')
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.slug == slug;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.role == "owner"
        && getAfter(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid;
      allow read: if isSelf(userId);
      allow update: if isSelf(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /businesses/{businessId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.plan == "free"
        && request.resource.data.subscriptionStatus == "trialing";
      allow read: if isOwner(businessId);
      allow update: if isOwner(businessId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.trialEndsAt == resource.data.trialEndsAt;
      allow delete: if false;

      match /landingConfig/{configId} {
        allow read, write: if isOwner(businessId);
      }

      match /services/{serviceId} {
        allow read, write: if isOwner(businessId);
      }

      match /staff/{staffId} {
        allow read, write: if isOwner(businessId);
      }

      match /appointments/{appointmentId} {
        allow read, update: if isOwner(businessId);
        allow create, delete: if false;
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(businessId);
      }

      match /notifications/{notificationId} {
        allow read, update: if isOwner(businessId);
        allow create, delete: if false;
      }
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
